# Auxidien public website environment variables.

# Chain (97 = BSC testnet, 56 = BSC mainnet)
NEXT_PUBLIC_CHAIN_ID=97

# Contract addresses for the target chain
NEXT_PUBLIC_AUXI_TOKEN_ADDRESS=
NEXT_PUBLIC_AUXIDIEN_ORACLE_ADDRESS=
NEXT_PUBLIC_AUXI_VESTING_ADDRESS=

# Optional override; defaults to viem's chain RPC
NEXT_PUBLIC_RPC_URL=

# Anthropic chat assistant
ANTHROPIC_API_KEY=

# Upstash (optional, for caching)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
